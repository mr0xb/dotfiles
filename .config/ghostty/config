background-blur-radius = 15 
background-opacity = 0.9
#theme = dark:cyberdream, light:cyberdream-light
#theme = challengerdeep
theme = "Challenger Deep"

#window-theme = system

#font-family = "MesloLGS Nerd Font Mono"
font-family = "IBM Plex Mono"
font-size = 20

window-padding-x = 10
